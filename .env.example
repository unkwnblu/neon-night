# Copy to .env.local and fill in for local development (sandbox/test keys).
# For production values (live Bachs keys, real passwords) use .env.production.local, which
# `next build` / `next start` read first. Never commit either file.

# Supabase project: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The "service_role" key (secret). Only ever used on the server.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin. Use something long.
ADMIN_PASSWORD=
# Door staff password: signs in to the check-in scanner only (no sales, prices or refunds).
DOOR_PASSWORD=
# Random string of at least 32 characters that signs admin sessions.
# Generate one with: openssl rand -base64 48
# Changing it signs every admin out.
ADMIN_SESSION_SECRET=

# Bachs payments (https://docs.bachs.io). Sandbox keys start sk_sandbox_, live keys sk_live_;
# the API address is picked from the key.
BACHS_API_KEY=
# Signing secret of the webhook endpoint you add in the Bachs developer portal,
# pointing at https://<your-domain>/api/bachs/webhook
BACHS_WEBHOOK_SECRET=
# Public address of the site, used for the after-payment return links (optional on the live domain).
SITE_URL=https://brickcityevent.site

# Resend (https://resend.com): receipt and ticket emails.
RESEND_API_KEY=
# Sender, on a domain verified in Resend.
EMAIL_FROM=Neon Night <tickets@brickcityevent.site>
# Optional: where replies go.
EMAIL_REPLY_TO=
